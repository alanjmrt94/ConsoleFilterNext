# ─── Gradle ─────────────────────────────────────────────────────────────────
.gradle/
**/.gradle/
**/build/
!src/**/build/
gradle-app.setting
.gradletasknamecache

# Wrapper (keep tracked; también en platforms/{mc}/{loader}/)
!**/gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.properties

# Local Maven repo (build.gradle publishing)
mcmodsrepo/

# ─── Minecraft / loader dev runs (agrupados por versión) ─────────────────────
runs/
# Por si queda algún run legacy en la raíz
/run/
/run-*/

# Runs locales dentro de un módulo (p. ej. ForgeGradle legacy)
platforms/**/run/

# Compiled leftovers / NeoForm tooling artifacts
**/*.class
**/.mixin.out/
# Decompilados de Minecraft: solo árboles generados, no src/**/java/net/
/net/
**/run/**/net/
**/.gradle/**/net/
**/build/**/net/
# Dump NeoForm en la raíz del módulo (p. ej. platforms/26.x/neoforge/net)
platforms/**/forge/net/
platforms/**/neoforge/net/
platforms/**/fabric/net/

# Manifest local de launcher (apunta a 127.0.0.1)
versions/minecraft-meta/launcher_manifest_local.json

# ─── IDE ────────────────────────────────────────────────────────────────────
# Eclipse
.project
.classpath
.settings/
bin/

# IntelliJ IDEA
.idea/
*.iml
out/

# VS Code / Cursor (editor settings are local)
.vscode/

# Cursor — plan de desarrollo local
.cursor/

# ─── Secretos y config de máquina ───────────────────────────────────────────
.env
.env.*
!.env.example
*.local
!*.local.example
local.properties
*.keystore
*.jks

# ─── Scripts (secrets) ───────────────────────────────────────────────────────
scripts/.release.local

# Artefactos temporales de publicación
scripts/*-response.json
response.txt

# ─── Release / build artifacts en raíz ───────────────────────────────────────
/consolefilternext-*.jar

# ─── Logs y crashes JVM ─────────────────────────────────────────────────────
*.log
hs_err_pid*
replay_pid*

# ─── Sistema operativo ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
